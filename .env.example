APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VS score screenshot OCR (vision model used to read the VS "Weekly Rank" screen).
# Provider and model must be set together; measure a candidate first with
# `php artisan vs:ocr-check --provider=… --model=…`.
VS_OCR_PROVIDER=gemini
VS_OCR_MODEL=gemini-flash-latest

# Required by the VS OCR only if you move it back to an "anthropic" provider above.
ANTHROPIC_API_KEY=

# Required by the VS score OCR on its default "gemini" provider.
# Get a key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Last War API toolkit (https://api.lastwar.tools) — live alliance roster and VS scores.
# LASTWAR_API_KEY is sent as the X-API-Key header and is required for every call.
# LASTWAR_SESSION_KEY is optional but required by all /vs/* endpoints; without it
# requests are queued behind a shared connection pool. Get one by running the Capture
# Tool (https://github.com/LastWarTools/Capture-Tool), then POST /auth/credentials/upload.
# LASTWAR_ALLIANCE_ID is a fallback 32-char hex alliance ID, used only for teams
# that have no alliance_id of their own (GET /rankings/{server_id}/alliances).
LASTWAR_API_KEY=
LASTWAR_SESSION_KEY=
LASTWAR_ALLIANCE_ID=
