APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Required by a managed MySQL that enforces TLS, e.g. Laravel Cloud.
# MYSQL_ATTR_SSL_CA="/etc/ssl/certs/ca-certificates.crt"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true anywhere the app is served over HTTPS.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

# Screenshot uploads are read back by a queue worker, which in production is a
# separate machine with its own empty filesystem. Anywhere the web and queue
# processes are not the same process, this must be a shared disk ("s3"), not "local".
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes mail to the log instead of sending it, which is what you want locally.
# Anywhere mail has to actually arrive — registration verification and team invitations
# both depend on it — set this to "resend" and fill in RESEND_API_KEY below.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Resend rejects anything sent from a domain you have not verified with them, so this
# cannot stay on example.com once MAIL_MAILER is "resend".
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Transactional mail (https://resend.com/api-keys). Only read when MAIL_MAILER=resend.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VS score screenshot OCR (vision model used to read the VS "Weekly Rank" screen).
# The models are not configurable: they live in AiVisionVsScoreScreenshotReader::PROVIDERS
# as one ordered chain, currently Gemini Flash failing over to OpenAI and then Anthropic.
# Only the keys are set here, and a link with no key is simply skipped.

# Read by the primary provider. Get a key from Google AI Studio
# (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Read by the first fallback, used when Gemini is rate limited, overloaded, or out of
# credits. Get a key from https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Read by the second fallback. Get a key from https://console.anthropic.com.
ANTHROPIC_API_KEY=

# Last War API toolkit (https://api.lastwar.tools) — live alliance roster and VS scores.
# LASTWAR_API_KEY is sent as the X-API-Key header and is required for every call.
# LASTWAR_SESSION_KEY is optional but required by all /vs/* endpoints; without it
# requests are queued behind a shared connection pool. Get one by running the Capture
# Tool (https://github.com/LastWarTools/Capture-Tool), then POST /auth/credentials/upload.
# LASTWAR_ALLIANCE_ID is a fallback 32-char hex alliance ID, used only for teams
# that have no alliance_id of their own (GET /rankings/{server_id}/alliances).
LASTWAR_API_KEY=
LASTWAR_SESSION_KEY=
LASTWAR_ALLIANCE_ID=

# Octane serves the app from long-lived FrankenPHP workers. Reload workers after
# deploying (php artisan octane:reload) or code changes will not be picked up.
OCTANE_SERVER=frankenphp
